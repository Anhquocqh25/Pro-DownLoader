[Unit]
Description=Pro Downloader PWA and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prodownloader
Group=prodownloader
WorkingDirectory=/opt/pro-downloader/app
EnvironmentFile=/etc/pro-downloader.env
ExecStart=/opt/pro-downloader/venv/bin/python -m pro_downloader_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/pro-downloader

[Install]
WantedBy=multi-user.target
